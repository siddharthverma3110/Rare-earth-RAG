# Copy to .env for local dev. NEVER commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Needed for reasoning models such as gpt-6-luna (function tools require reasoning off on this API). Leave blank for gpt-4o.
OPENAI_REASONING_EFFORT=
# Public-site abuse protection (protects your API bill)
RATE_LIMIT_PER_HOUR=30
DAILY_REQUEST_CAP=500
# Comma-separated origins allowed to call the API from other sites (leave blank if the UI is served by this app)
CORS_ORIGINS=
